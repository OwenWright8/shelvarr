# Copy this to .env next to docker-compose.yml, and change what you need.

# The folder holding both audiobooks/ and downloads/audiobooks/ on this machine.
# MEDIA_DIR=/volume2/Media

# Who owns your audiobook files (run `id` on the machine).
# PUID=1000
# PGID=1000

# Where Shelvarr keeps its database.
# DATA_DIR=./data

# The port the app is published on.
# APP_PORT=8687

# Time zone for log timestamps.
# TZ=America/Indiana/Indianapolis

# Every 6 hours the server asks GitHub for the latest release (one anonymous
# request; nothing about you is sent) and the app tells you about updates.
# UPDATE_CHECK=on

# Pin a release (v1.0.0) or a minor series (1.0) instead of latest.
# SHELVARR_VERSION=latest
